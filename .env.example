# Copy to `.env` for local development. Real deployments should inject these
# through the platform's secret mechanism instead of a file on disk.

# `development` or `production`. Production refuses to start without TLS.
APP_ENV=development
APP_BIND_ADDR=127.0.0.1:8443

# How access tokens are written and read. `jwt` (HS256) is the only format
# today and the default. Refresh tokens are unaffected — they are opaque and
# revocable server-side whatever this says. An unknown value stops the server
# rather than falling back, because a deployment that asked for one format and
# silently got another is the mistake this setting exists to prevent.
#APP_TOKEN_FORMAT=jwt

# REQUIRED. At least 32 bytes. Generate with:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data
APP_JWT_ISSUER=bastion
APP_JWT_AUDIENCE=bastion-api

# Access tokens stay short-lived; sessions are carried by refresh tokens.
APP_ACCESS_TOKEN_TTL_SECS=900
APP_REFRESH_TOKEN_TTL_SECS=1209600

# TLS. Both must be set together; both are mandatory when APP_ENV=production.
#APP_TLS_CERT_PATH=certs/cert.pem
#APP_TLS_KEY_PATH=certs/key.pem

APP_DATABASE_URL=sqlite://data/app.db?mode=rwc
APP_DATABASE_MAX_CONNECTIONS=16
APP_DATABASE_ACQUIRE_TIMEOUT_SECS=5

# Request limits.
APP_BODY_LIMIT_BYTES=262144
APP_REQUEST_TIMEOUT_SECS=15
APP_MAX_CONCURRENCY=1024
APP_SHUTDOWN_GRACE_SECS=20

# Connection limits. These bound sockets rather than requests: a client that
# opens a connection and stalls never produces a request, so the limits above
# never see it.
APP_MAX_CONNECTIONS=4096
APP_HEADER_READ_TIMEOUT_SECS=10
APP_TLS_HANDSHAKE_TIMEOUT_SECS=10
APP_MAX_CONCURRENT_STREAMS=128

# Directory of prebuilt frontend assets. When set, anything not matching an API
# route is served from here, with unknown paths falling back to index.html so
# client-side routing works. These responses get a page-appropriate CSP and a
# cache lifetime; the API keeps its own stricter headers either way.
#APP_STATIC_DIR=./bastion

# How many Argon2 hashes may run at once. Each reserves 19 MiB and a core, and
# an unauthenticated request triggers one, so this is the ceiling on what a login
# flood can consume. Defaults to the core count; raising it does not add
# throughput, it just multiplies resident memory.
#APP_MAX_CONCURRENT_HASHES=8

# One-time administrator seed. Both must be set together, or neither. On start-up
# the account is created, or an existing one is promoted (its password is left
# untouched). Unset both once the administrator exists.
#APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#APP_BOOTSTRAP_ADMIN_PASSWORD=a-long-bootstrap-password

# Brute-force protection, on top of the per-IP rate limit below.
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOCKOUT_SECS=900

# Rate limiting: one slot returns every N seconds, up to `BURST` in hand.
APP_RATE_LIMIT_PER_SECOND=1
APP_RATE_LIMIT_BURST=60
APP_AUTH_RATE_LIMIT_PER_SECOND=5
APP_AUTH_RATE_LIMIT_BURST=5

# Exact origins only, comma-separated. Empty means same-origin only.
# `*` is rejected at start-up.
APP_CORS_ALLOWED_ORIGINS=

# Only enable behind a reverse proxy you control. When true, X-Forwarded-For
# decides a client's rate-limit identity — and a direct client could forge it.
APP_TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Middleware plugins
#
# The shipped plugins are all on by default and tuned here. A plugin can only
# add a layer or a pre-routing check, so switching one off never removes a core
# protection — the hardening headers, canonicalisation, body limits, deadlines
# and load shedding are not plugins and cannot be configured away.
#
# A value that does not parse stops the server. It is never a silent default.
# ---------------------------------------------------------------------------

# Per-client rate limiting, using the APP_RATE_LIMIT_* buckets above. This is
# the one plugin that cannot be disabled when APP_ENV=production.
#APP_PLUGIN_RATE_LIMIT_ENABLED=true

# CORS, using APP_CORS_ALLOWED_ORIGINS above. With no origins listed the plugin
# installs nothing, which is same-origin only. Preflight cache, max 86400.
#APP_PLUGIN_CORS_ENABLED=true
#APP_PLUGIN_CORS_MAX_AGE_SECS=600

# One structured log line per request: method, matched route, status, latency.
# SAMPLE=N logs one successful response in N; failures are never sampled out.
# HEADERS is an allowlist — anything carrying credentials is refused at
# start-up. CLIENT_IP is opt-in because an address is personal data.
#APP_PLUGIN_REQUEST_LOG_ENABLED=true
#APP_PLUGIN_REQUEST_LOG_SAMPLE=1
#APP_PLUGIN_REQUEST_LOG_HEADERS=user-agent,referer
#APP_PLUGIN_REQUEST_LOG_CLIENT_IP=false

# Refuses URLs whose spelling is a technique rather than an address: encoded
# separators, dot segments, control characters, backslashes, and repeated query
# keys — `?limit=1&limit=2` parses differently in different parsers, which is
# how a gateway rule written against the first gets bypassed by the second.
#APP_PLUGIN_PATH_GUARD_ENABLED=true
#APP_PLUGIN_PATH_GUARD_MAX_PATH_LEN=2048
#APP_PLUGIN_PATH_GUARD_MAX_QUERY_LEN=4096
#APP_PLUGIN_PATH_GUARD_MAX_QUERY_PAIRS=32
#APP_PLUGIN_PATH_GUARD_ALLOW_DUPLICATE_QUERY=false

# Refuses requests whose Host is not one this deployment answers to — the lever
# behind cache poisoning and rewritten password-reset links. Off until you list
# hosts, because the right answer is deployment-specific and a wrong guess is an
# outage. Exact hosts, comma-separated; `*` is rejected at start-up.
#APP_PLUGIN_HOST_GUARD_HOSTS=api.example.com,www.example.com

# Methods that may reach the router at all. TRACE is the one that matters: it
# reflects the request back, which is how cross-site tracing reads a header the
# browser would not otherwise hand over.
#APP_PLUGIN_METHOD_GUARD_ENABLED=true
#APP_PLUGIN_METHOD_GUARD_METHODS=GET,HEAD,POST,PUT,DELETE,OPTIONS

# Requires application/json on API requests carrying a body. This is the CSRF
# guard for a token-authenticated API: a cross-origin form can only send
# urlencoded, multipart or plain text, never JSON.
#APP_PLUGIN_CONTENT_TYPE_GUARD_ENABLED=true
#APP_PLUGIN_CONTENT_TYPE_GUARD_REQUIRE_JSON=true

# Log filter, `tracing-subscriber` syntax.
APP_LOG=info,bastion=info,tower_http=info,sqlx=warn
