# Regenerated by `next dev` and `next build`, and the two disagree — dev points
# the routes import at .next/dev/types, build at .next/types. Tracking it means
# the tree goes dirty every time you switch between them. Nothing is lost:
# either command writes it, and `tsc --noEmit` passes without it.
next-env.d.ts
