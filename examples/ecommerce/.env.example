# Copy to .env.local and fill in the two secrets.

# --- BetterAuth (owns the browser session) ---------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Local shop database ----------------------------------------------------
DATABASE_URL=./shop.db

# --- Bastion (owns credentials) ---------------------------------------------
BASTION_URL=http://127.0.0.1:8080
BASTION_API_PREFIX=/api/v1

# Seals Bastion tokens at rest. 32 bytes, base64:
# openssl rand -base64 32
BASTION_TOKEN_SECRET=

BASTION_TIMEOUT_MS=8000

# Refresh when the access token has fewer than this many seconds left.
# Set it above the access-token TTL to force a refresh on every call — that is
# how you exercise the single-flight lease.
BASTION_REFRESH_SKEW_SECONDS=30

BASTION_REFRESH_LEASE_MS=15000

# Forward the end user's IP so Bastion's rate limiter buckets per user rather
# than per Next process. Only turn this on when Bastion sits behind a proxy you
# control with APP_TRUST_PROXY_HEADERS=true.
BASTION_FORWARD_CLIENT_IP=false
