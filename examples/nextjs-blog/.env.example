# Where Bastion is listening. Server-to-server only: no browser ever talks to
# it, so APP_CORS_ALLOWED_ORIGINS can stay empty on the Bastion side.
BASTION_URL=http://127.0.0.1:8080

# Encrypts the Bastion token pair at rest in blog.db. 32 bytes, base64.
#   openssl rand -base64 32
BASTION_TOKEN_SECRET=

DATABASE_URL=./blog.db
