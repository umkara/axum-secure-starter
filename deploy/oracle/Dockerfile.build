# Build-only image: produces one Linux binary and nothing else.
#
# The architecture comes from the `--platform` build.sh passes, which defaults
# to linux/amd64 because the instance is x86_64. Nothing here is
# architecture-specific: the compile runs inside an image of the target
# architecture rather than cross-linking, so on an Apple Silicon Mac an amd64
# build is emulated and slow. The final stage is `scratch` because the only
# artefact wanted is the executable.

ARG RUST_IMAGE=rust:1-bookworm

# No `--platform=$TARGETPLATFORM` here: that is already the default, and stating
# it earns a RedundantTargetPlatform warning on every build.
FROM ${RUST_IMAGE} AS build

# Cargo feature flags, already assembled by build.sh — e.g.
# `--no-default-features --features postgres`. Empty means the defaults.
#
# Unquoted where it is used, deliberately: it has to word-split into separate
# arguments, and it comes from this repository's own build script rather than
# from anything a caller controls.
ARG CARGO_FEATURES=

# Concurrency cap, as a ready-made `--jobs N` or empty for cargo's default (one
# job per core). build.sh sizes it against the builder's RAM.
#
# It matters more than it looks. rustc is memory-hungry — a job per core on a
# small builder is how a Rust build exhausts the machine rather than merely
# loading it, and the process that dies is whichever the host picks, not
# necessarily this build. Same word-splitting note as CARGO_FEATURES.
ARG CARGO_JOBS=

# aws-lc-rs (used by rustls, sqlx and jsonwebtoken here) compiles C and needs
# both cmake and clang; the base image ships neither.
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake clang \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Dependencies change far less often than the source, so build them against a
# stub first and let the layer cache keep them. The features have to match the
# real build below, or this layer compiles a different dependency set and buys
# nothing.
COPY Cargo.toml Cargo.lock ./
# Every target the manifest declares needs a file here, or cargo refuses to
# parse it — `bastion-migrate-store` has `required-features`, but cargo resolves
# target paths before it decides what to build.
RUN mkdir -p src/bin \
 && echo 'fn main() {}' > src/main.rs \
 && echo '' > src/lib.rs \
 && echo 'fn main() {}' > src/bin/bastion-migrate-store.rs \
 && cargo build --release --locked ${CARGO_FEATURES} ${CARGO_JOBS} \
 && rm -rf src

COPY . .
# The stub's fingerprint would otherwise be reused for the real crate.
RUN touch src/main.rs src/lib.rs src/bin/bastion-migrate-store.rs \
 && cargo build --release --locked ${CARGO_FEATURES} ${CARGO_JOBS}

# Debian bookworm carries glibc 2.36; Ubuntu 24.04 carries 2.39. Building
# against the older one keeps the binary loadable on the newer host.
FROM scratch AS artifact
COPY --from=build /src/target/release/bastion /bastion
