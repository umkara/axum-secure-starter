# Installed as /etc/bastion/env, owned root:axum, mode 0640.
# `deploy.sh --env <file>` uploads it. Never commit the filled-in copy.

APP_ENV=production
APP_BIND_ADDR=0.0.0.0:443

# REQUIRED, at least 32 bytes:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-me
APP_JWT_ISSUER=bastion
APP_JWT_AUDIENCE=bastion-api

APP_ACCESS_TOKEN_TTL_SECS=900
APP_REFRESH_TOKEN_TTL_SECS=1209600

# Written by the certbot deploy hook on every renewal.
APP_TLS_CERT_PATH=/etc/bastion/certs/fullchain.pem
APP_TLS_KEY_PATH=/etc/bastion/certs/privkey.pem

APP_DATABASE_URL=sqlite:///var/lib/bastion/app.db?mode=rwc
APP_DATABASE_MAX_CONNECTIONS=16
APP_DATABASE_ACQUIRE_TIMEOUT_SECS=5

APP_BODY_LIMIT_BYTES=262144
APP_REQUEST_TIMEOUT_SECS=15
APP_MAX_CONCURRENCY=1024
APP_SHUTDOWN_GRACE_SECS=20

APP_MAX_CONNECTIONS=4096
APP_HEADER_READ_TIMEOUT_SECS=10
APP_TLS_HANDSHAKE_TIMEOUT_SECS=10
APP_MAX_CONCURRENT_STREAMS=128

APP_STATIC_DIR=/opt/bastion/docs

# Left unset: the default is the core count, which is 2 on the free A1 shape.
# Each concurrent hash reserves 19 MiB, so the default costs ~38 MiB.
#APP_MAX_CONCURRENT_HASHES=2

# Set both for the first boot only, then remove them and restart.
#APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#APP_BOOTSTRAP_ADMIN_PASSWORD=a-long-bootstrap-password

APP_MAX_LOGIN_ATTEMPTS=5
APP_LOCKOUT_SECS=900

APP_RATE_LIMIT_PER_SECOND=1
APP_RATE_LIMIT_BURST=60
APP_AUTH_RATE_LIMIT_PER_SECOND=5
APP_AUTH_RATE_LIMIT_BURST=5

APP_CORS_ALLOWED_ORIGINS=

# Must stay false. Nothing sits in front of this server, so the peer address is
# the real client — and a direct client could otherwise forge X-Forwarded-For to
# escape its own rate limit.
APP_TRUST_PROXY_HEADERS=false

APP_LOG=info,bastion=info,tower_http=info,sqlx=warn
